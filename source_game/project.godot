; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tiên Môn Linh Vận"
config/description="A playful mobile xianxia sect management game in Vietnamese, with blue-white jade UI and peach-pink accents."
config/version="2.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.78, 0.92, 1, 1)
boot_splash/show_image=false
boot_splash/image="res://assets/boutique/tu_tien_interior.png"
config/icon="res://assets/share/favicon.png"

[autoload]

TuningBridge="*res://scripts/manus/preview/tuning_adapter.gd"
ManusFontTheme="*res://autoload/manus_font_theme.gd"
SaveStore="*res://autoload/save_store.gd"
I18n="*res://autoload/i18n.gd"
TuningStore="*res://autoload/tuning_store.gd"
AudioDirector="*res://autoload/audio_director.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=995
window/size/window_width_override=540
window/size/window_height_override=995
window/stretch/mode="canvas_items"

[editor]

import/use_multiple_threads=false

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

